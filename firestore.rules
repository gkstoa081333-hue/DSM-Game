rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 학습 기록: 본인만 읽기·쓰기·삭제
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['level','dojo','rec','nick','seen','wrong','codex','updatedAt','app'])
        && request.resource.data.seen.size() <= 5000
        && request.resource.data.wrong.size() <= 5000
        && request.resource.data.codex.size() <= 5000;
    }
    // 문제 신고: 보내기만 가능
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['qid','note','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
      allow read, update, delete: if false;
    }
    // 닉네임 선점: 이름 문서 하나에 주인 uid 하나 (중복 방지)
    match /names/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && name.size() >= 2 && name.size() <= 12
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    // 랭킹: 누구나(로그인 사용자) 읽기, 본인 줄만 쓰기, 닉네임은 내가 선점한 것만
    match /board/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick','tier','score','rk','dojo','final','dk','ta','surv','tests','updatedAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 12
        && get(/databases/$(database)/documents/names/$(request.resource.data.nick.lower())).data.uid == request.auth.uid
        && request.resource.data.tier is int && request.resource.data.tier <= 4
        && request.resource.data.score is int && request.resource.data.score <= 100;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
