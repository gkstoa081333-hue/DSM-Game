rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 학습 기록: 본인만 읽기·쓰기·삭제
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['level','dojo','rec','nick','seen','wrong','codex','updatedAt','app'])
        && request.resource.data.seen.size() <= 5000
        && request.resource.data.wrong.size() <= 5000
        && request.resource.data.codex.size() <= 5000;
    }
    // 문제 신고: 보내기만 가능
    match /reports/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['qid','note','uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
      allow read, update, delete: if false;
    }
    // 1:1 대결: 코드(6자리)를 아는 로그인 사용자만 읽기, 각자 자기 칸만 수정
    match /matches/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && code.size() == 6
        && request.resource.data.keys().hasOnly(['host','guest','qids','createdAt'])
        && request.resource.data.host.uid == request.auth.uid
        && request.resource.data.host.nick is string && request.resource.data.host.nick.size() <= 12
        && request.resource.data.guest == null
        && request.resource.data.qids.size() == 10;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['host','guest','qids','createdAt'])
        && request.resource.data.qids == resource.data.qids
        && (
          (resource.data.guest == null
            && request.resource.data.host == resource.data.host
            && request.resource.data.guest.uid == request.auth.uid
            && resource.data.host.uid != request.auth.uid
            && request.resource.data.guest.nick is string && request.resource.data.guest.nick.size() <= 12)
          || (resource.data.host.uid == request.auth.uid
            && request.resource.data.host.uid == request.auth.uid
            && request.resource.data.host.nick == resource.data.host.nick
            && request.resource.data.guest == resource.data.guest)
          || (resource.data.guest != null && resource.data.guest.uid == request.auth.uid
            && request.resource.data.guest.uid == request.auth.uid
            && request.resource.data.guest.nick == resource.data.guest.nick
            && request.resource.data.host == resource.data.host)
        );
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
